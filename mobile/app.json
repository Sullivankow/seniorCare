{
  "expo": {
    "name": "SeniorCare",
    "slug": "seniorcare",
    "version": "0.1.0",
    "scheme": "seniorcare",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "SeniorCare utilise le microphone pour enregistrer vos messages vocaux.",
          "enableBackgroundRecording": false
        }
      ]
    ]
  }
}
