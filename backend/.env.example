# MEDIA_S3_REGION=eu-west-3
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=
# MEDIA_S3_FORCE_PATH_STYLE=false
